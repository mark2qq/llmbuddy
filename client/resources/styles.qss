/* -*- coding: utf-8 -*- */
/*
 * 现代深色主题（styles.qss）
 * 参考豆包 / workbuddy / codex 观感：深背景 + 蓝紫渐变强调色 + 圆角卡片。
 * 主色 #6c8cff，背景 #0f1117，卡片 #1a1d27。
 */
QWidget {
    background-color: #0f1117;
    color: #d7dbe5;
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 13px;
}

/* ---------------- 主窗口 / 面板 ---------------- */
QMainWindow {
    background-color: #0f1117;
}

/* 页面外层滚动区（控制台等）：容器透明，不遮盖卡片圆角 */
#PageScroll, #PageContent {
    background: transparent;
    border: none;
}

#NavPanel {
    background-color: #14161f;
    border-right: 1px solid #232734;
}

#NavTitle {
    background: transparent;
    border: none;
}

#NavTitleLabel {
    background: transparent;
    color: #e8ebf2;
    font-size: 18px;
    font-weight: 700;
    border: none;
}

#NavVersionLabel {
    background: transparent;
    color: #7d8596;
    font-size: 11px;
    border: none;
}

#NavButton {
    background-color: transparent;
    color: #c2c8d6;
    border: none;
    border-left: 3px solid transparent;
    text-align: left;
    padding-left: 18px;
    border-radius: 0;
}

#NavButton:hover {
    background-color: #1d2230;
    color: #ffffff;
}

#NavButton:checked {
    background-color: #20263a;
    color: #ffffff;
    border-left: 3px solid #6c8cff;
}

/* ---------------- 卡片 ---------------- */
QGroupBox#Card {
    background-color: #1a1d27;
    border: 1px solid #262b3a;
    border-radius: 12px;
    margin-top: 12px;
    padding: 14px;
}

QGroupBox#Card::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #9aa3b8;
    font-weight: 600;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background-color: #262b3a;
    color: #e6e9f2;
    border: 1px solid #323849;
    border-radius: 8px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #2f3548;
    border-color: #3d4456;
}

QPushButton:pressed {
    background-color: #20242f;
}

QPushButton:disabled {
    background-color: #1b1e29;
    color: #5b6275;
    border-color: #232734;
}

#PrimaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6c8cff, stop:1 #8a6cff);
    color: #ffffff;
    border: none;
    font-weight: 600;
}

#PrimaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7d9bff, stop:1 #9a7dff);
}

#DangerBtn {
    background-color: #3a2230;
    border: 1px solid #5a2f44;
    color: #ff9bb3;
}

#DangerBtn:hover {
    background-color: #4a2a3b;
}

#DownloadBtn {
    background-color: transparent;
    color: #8b9bff;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    min-height: 24px;
    max-height: 30px;
}

#DownloadBtn:hover {
    background-color: rgba(124, 140, 255, 0.14);
    color: #aeb9ff;
}

#DownloadBtn:pressed {
    background-color: rgba(124, 140, 255, 0.22);
}

/* 模型库操作列紧凑按钮（删除 / 重新下载） */
#CellBtn {
    background-color: transparent;
    color: #c9d0e0;
    border: 1px solid #323849;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 12px;
    min-height: 22px;
    max-height: 26px;
}
#CellBtn:hover { background-color: #262b3a; border-color: #3d4456; }
#LocalBadge {
    background-color: rgba(61, 220, 132, 0.12); color: #3ddc84;
    border: 1px solid rgba(61, 220, 132, 0.35); border-radius: 10px;
    padding: 2px 12px; font-size: 12px; font-weight: 600;
}
#TinyBtn { padding: 2px 12px; font-size: 12px; min-height: 20px; max-height: 24px; border-radius: 6px; }
#TinyDangerBtn { padding: 2px 12px; font-size: 12px; min-height: 20px; max-height: 24px; border-radius: 6px;
    background-color: #3a2230; border: 1px solid #5a2f44; color: #ff9bb3; }
#TinyDangerBtn:hover { background-color: #4a2a3b; }

/* 对话页：底部「+ 模型」按钮 + 当前模型标签（参考豆包） */
#ModelAddBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6c8cff, stop:1 #8a6cff);
    color: #ffffff;
    border: none;
    border-radius: 7px;
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 600;
    min-height: 26px;
    max-height: 30px;
}
#ModelAddBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #7d9bff, stop:1 #9a7dff);
}

/* 对话页：底部模型下拉按钮（WorkBuddy 式）+ 圆形发送/停止按钮 */
#ModelDropBtn {
    background-color: #232734;
    color: #c9d0e0;
    border: 1px solid #323849;
    border-radius: 7px;
    padding: 5px 12px;
    font-size: 13px;
    min-height: 26px;
    max-height: 30px;
    text-align: left;
}
#ModelDropBtn:hover { background-color: #2d3242; border-color: #3d4456; }
#SendCircleBtn {
    background-color: #2f3b66;
    border: none;
    border-radius: 20px;
}
#SendCircleBtn:hover { background-color: #3a4a7d; }
#SendCircleBtn:pressed { background-color: #26305a; }
#ModelChip {
    background-color: #181b26;
    border: 1px solid #262b3a;
    border-radius: 7px;
    color: #c9d0e0;
    padding: 4px 12px;
    font-size: 13px;
    min-height: 24px;
}

/* 对话页「+ 模型」选择面板（参考 WorkBuddy：深色圆角面板、条目悬浮高亮、分组标题置灰） */
QMenu#ModelMenu {
    background-color: #1a1e2b;
    border: 1px solid #2c3142;
    border-radius: 10px;
    padding: 6px;
}
QMenu#ModelMenu::item {
    padding: 7px 14px;
    border-radius: 6px;
    color: #e6e9f2;
    font-size: 13px;
    background-color: transparent;
}
QMenu#ModelMenu::item:selected { background-color: #2c3550; }
QMenu#ModelMenu::item:disabled { color: #8a93a8; font-size: 12px; padding: 5px 14px 3px 14px; }
QMenu#ModelMenu::separator { height: 1px; background-color: #2c3142; margin: 6px 8px; }

/* 控制台「已加载模型」卡片行：正常尺寸按钮，清晰可读 */
#LoadedScroll { background-color: transparent; border: none; }
#LoadedCard {
    background-color: #181b26;
    border: 1px solid #262b3a;
    border-radius: 10px;
}
#LoadedName { color: #e6e9f2; font-size: 14px; font-weight: 600; }
#MutedLabel { color: #9aa3b8; font-size: 12px; }
#RowBtn {
    background-color: #2f3b66; color: #ffffff;
    border: none; border-radius: 6px;
    padding: 3px 12px; font-size: 12px; font-weight: 600;
    min-height: 20px; max-height: 24px;
}
#RowBtn:hover { background-color: #3a4a7d; }
#RowBtn:disabled { background-color: #232734; color: #6b7284; }
#RowDangerBtn {
    background-color: #3a2230; color: #ff9bb3;
    border: 1px solid #5a2f44; border-radius: 6px;
    padding: 3px 12px; font-size: 12px; font-weight: 600;
    min-height: 20px; max-height: 24px;
}
#RowDangerBtn:hover { background-color: #4a2a3b; }
#RowCancelBtn {
    background-color: #232734; color: #c9d0e0;
    border: 1px solid #323849; border-radius: 6px;
    padding: 3px 10px; font-size: 12px; font-weight: 600;
    min-height: 20px; max-height: 24px;
}
#RowCancelBtn:hover { background-color: #2d3242; }
#RowBtn { min-width: 52px; }
#RowDangerBtn { min-width: 52px; }
#RowCancelBtn { min-width: 64px; }

/* ---------------- 输入框 / 下拉 ---------------- */
QLineEdit, QSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #12141d;
    color: #e6e9f2;
    border: 1px solid #2c3142;
    border-radius: 8px;
    padding: 6px 8px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #6c8cff;
}

QLineEdit:read-only, QTextEdit:read-only {
    color: #aab0c0;
}

QComboBox QAbstractItemView {
    background-color: #1a1d27;
    color: #e6e9f2;
    selection-background-color: #2f3548;
    border: 1px solid #2c3142;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #1d2230;
    border: none;
    width: 16px;
}

/* ---------------- 标签 / 信息 ---------------- */
QLabel {
    background: transparent;
    color: #c2c8d6;
}

#InfoLabel {
    color: #cdd3e2;
    line-height: 1.5;
}

#StatusDot {
    background: transparent;
}

#ApiUrlField, #ApiKeyField {
    font-family: "Consolas", "Courier New", monospace;
}

/* ---------------- 状态栏 ---------------- */
#StatusBar {
    background-color: #14161f;
    border-top: 1px solid #232734;
}

#StatusBar QLabel {
    color: #aab0c0;
}

/* ---------------- 表格 ---------------- */
QTableWidget, QListWidget {
    background-color: #12141d;
    border: 1px solid #2c3142;
    border-radius: 8px;
    gridline-color: #232734;
}

QTableWidget::item, QListWidget::item {
    padding: 6px;
    border-bottom: 1px solid #1d2230;
}

QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #2f3548;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1a1d27;
    color: #9aa3b8;
    border: none;
    border-bottom: 1px solid #2c3142;
    padding: 6px;
}

/* ---------------- 聊天气泡 ---------------- */
#UserBubble {
    background-color: #2f3b66;
    color: #ffffff;
    border-radius: 12px;
    padding: 10px 12px;
}

#AssistantBubble {
    background-color: #1a1d27;
    color: #e6e9f2;
    border: 1px solid #262b3a;
    border-radius: 12px;
    padding: 10px 12px;
}

#ChatInput {
    background-color: #12141d;
}

#ChatScroll {
    border: none;
    background-color: #0f1117;
}

/* ---------------- 进度条 ---------------- */
QProgressBar {
    background-color: #12141d;
    border: 1px solid #2c3142;
    border-radius: 6px;
    height: 16px;
    text-align: center;
    color: #cdd3e2;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6c8cff, stop:1 #8a6cff);
    border-radius: 5px;
}

/* ---------------- 滚动条 ---------------- */
/* 细滚动条：轨道透明、滑块半透明，不抢视觉（红字：滚动条默认不显示，
   需要滚动时才出现；页面级滚动条由 AutoHideScrollArea 控制显隐） */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 16%);
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 34%);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 页面浮层滚动条（AutoHideScrollArea 内置，默认隐藏） */
#OverlayScrollBar {
    background: transparent;
    border: none;
}

#OverlayScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 22%);
    border-radius: 3px;
    min-height: 36px;
}

#OverlayScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 42%);
}

/* ---------------- 对话框 ---------------- */
QDialog {
    background-color: #0f1117;
}

#LogView {
    background-color: #0c0e15;
    color: #b6c0d4;
    font-family: "Consolas", "Courier New", monospace;
    border: 1px solid #2c3142;
    border-radius: 8px;
}

/* ---------------- 系统托盘菜单（启停互斥：禁用项必须肉眼可辨） ---------------- */
QMenu#TrayMenu {
    background-color: #1a1e2b;
    border: 1px solid #2c3142;
    border-radius: 8px;
    padding: 6px;
}
QMenu#TrayMenu::item {
    padding: 8px 26px 8px 16px;
    border-radius: 6px;
    color: #e6e9f2;
    font-size: 13px;
    background-color: transparent;
}
QMenu#TrayMenu::item:selected { background-color: #2c3550; }
/* 禁用（已启动时「启动服务」/已停止时「停止服务」）：明显变灰 */
QMenu#TrayMenu::item:disabled { color: #5b6377; }

/* ---------------- 控制台「测试结果」：可滚动查看完整输出 ---------------- */
#TestResult {
    background-color: #0c0e15;
    border: 1px solid #2c3142;
    border-radius: 8px;
    color: #cfd6e6;
    font-size: 12px;
}

/* ================= 智能助理（1.0.8） ================= */
#PageTitle {
    color: #f2f4fa;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
    border: none;
}
#PageSubtitle {
    color: #7d8596;
    font-size: 11px;
    background: transparent;
    border: none;
}

QTabWidget::pane {
    background-color: #14161f;
    border: 1px solid #262b3a;
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #8b93a7;
    padding: 6px 12px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}
QTabBar::tab:selected { color: #ffffff; border-bottom: 2px solid #6c8cff; }
QTabBar::tab:hover { color: #d6dbe8; }

#AssistantSideBar {
    background-color: #14161f;
    border: 1px solid #262b3a;
    border-radius: 10px;
}

#ChatScroll { background-color: transparent; border: none; }
#ChatScroll > QWidget > QWidget { background-color: transparent; }

#UserBubble {
    background-color: #2a3350;
    color: #eef1fa;
    border: 1px solid #37426a;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
}
#BotBubble {
    background-color: #171a24;
    color: #e2e6f0;
    border: 1px solid #262b3a;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 13px;
}

#StepLine {
    color: #78808f;
    font-size: 11px;
    background: transparent;
    border: none;
    padding: 2px 0;
}

#ToolCard {
    background-color: #12141d;
    border: 1px solid #2a3040;
    border-left: 3px solid #4a5570;
    border-radius: 8px;
}
#ToolCard[risk="high"] { border-left: 3px solid #d9536f; }
#ToolCard[risk="medium"] { border-left: 3px solid #d99b3f; }
#ToolCard[risk="low"] { border-left: 3px solid #3f9bd9; }
#CardHead { color: #b9c2d6; font-size: 12px; background: transparent; border: none; }
#CardBody {
    color: #8f98ab;
    font-size: 11px;
    background: transparent;
    border: none;
    font-family: "Consolas", "Cascadia Mono", monospace;
}

/* 思考过程（WorkBuddy 形态：灰色「深度思考」+ 正文平铺，不折叠） */
#ThinkingBlock {
    background: transparent;
    border: none;
}
#ThinkingHead {
    color: #8f98ab;
    font-size: 11px;
    background: transparent;
    border: none;
    padding: 1px 0;
}
#ThinkingBody {
    color: #97a1b5;
    font-size: 12px;
    background: transparent;
    border: none;
    font-family: "Consolas", "Cascadia Mono", "Microsoft YaHei", monospace;
}

#ApprovalCard {
    background-color: #241a22;
    border: 1px solid #5a2f44;
    border-left: 3px solid #d9536f;
    border-radius: 8px;
}
#ApprovalTitle { color: #ffb3c4; font-size: 13px; font-weight: 700; background: transparent; border: none; }

#RiskHigh { color: #ff8fa8; font-size: 11px; background: transparent; border: none; }
#RiskMedium { color: #f0b862; font-size: 11px; background: transparent; border: none; }
#RiskLow { color: #6fc7e8; font-size: 11px; background: transparent; border: none; }

#MiniBtn {
    background-color: #232734;
    color: #aab2c4;
    border: 1px solid #2f3548;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 11px;
}
#MiniBtn:hover { background-color: #2d3242; color: #e6e9f2; }

/* ---------- 输入容器：底栏融合工具条（参考 WorkBuddy） ---------- */
#Composer {
    background-color: #14161f;
    border: 1px solid #2a3142;
    border-radius: 14px;
}
#Composer[focus="true"] { border: 1px solid #4d5f96; }

#Composer QTextEdit#ComposerInput,
#Composer QTextEdit#ComposerInput:focus {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 2px 4px;
    color: #e6e9f2;
    font-size: 13px;
}

/* 底栏图标按钮（附件 +） */
#BarBtn {
    background: transparent;
    color: #aeb6c6;
    border: none;
    border-radius: 13px;
    padding: 0;
    font-size: 16px;
}
#BarBtn:hover { background-color: #222839; color: #eef1fa; }

/* 底栏上下文胶囊（工作区 / 审批策略 / 技能 chip） */
#BarChip {
    background-color: #1a1f2e;
    color: #aeb6c6;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 0 7px;
    font-size: 11px;
    min-height: 24px;
    max-height: 24px;
}
#BarChip:hover { background-color: #232a3b; color: #eef1fa; }
#BarChip[active="true"] { background-color: #2b3450; color: #dfe6ff; }

/* 底栏模型下拉（无边框，悬浮才出底） */
#ModelChip {
    background: transparent;
    color: #c2c8d6;
    border: none;
    border-radius: 9px;
    padding: 0 8px;
    font-size: 12px;
    min-height: 26px;
    max-height: 26px;
}
#ModelChip:hover { background-color: #222839; color: #ffffff; }

/* 运行中指示（WorkBuddy 的加载环位置） */
#BusyDot {
    color: #8b93a7;
    font-size: 13px;
    background: transparent;
    border: none;
}

/* 发送 / 停止：实心圆（WorkBuddy 观感） */
#SendBtn {
    background-color: #e6e9f2;
    color: #12151c;
    border: none;
    border-radius: 15px;
    padding: 0;
    font-size: 15px;
    font-weight: 700;
}
#SendBtn:hover { background-color: #ffffff; }
#SendBtn:disabled { background-color: #2a3040; color: #6b7285; }

#StopBtn {
    background-color: #e6e9f2;
    color: #12151c;
    border: none;
    border-radius: 15px;
    padding: 0;
    font-size: 10px;
}
#StopBtn:hover { background-color: #ffffff; }

/* ---------- 引导会话队列面板（1.0.9：排队插话 / 引导发送） ---------- */
#QueuePanel {
    background-color: #14161f;
    border: 1px solid #2a3142;
    border-radius: 12px;
}
#QueueTitle {
    color: #8b93a7;
    font-size: 11px;
    background: transparent;
    border: none;
}
#QueueClearBtn {
    background: transparent;
    color: #8b93a7;
    border: 1px solid #2f3648;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    min-height: 20px;
    max-height: 24px;
}
#QueueClearBtn:hover { background-color: #232838; color: #e6e9f2; border-color: #3d4456; }
#QueueClearBtn:disabled { color: #5b6275; border-color: #232734; }
#QueueResumeBtn {
    background-color: #2f3b66;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
    min-height: 20px;
    max-height: 24px;
}
#QueueResumeBtn:hover { background-color: #3a4a7d; }
#QueueBody { background: transparent; border: none; }
#QueueRow {
    background-color: #181b26;
    border: 1px solid #262b3a;
    border-radius: 8px;
}
#QueueRow:hover { border-color: #3d4456; }
#QueueIdx {
    color: #7f8aa3;
    font-size: 11px;
    background: transparent;
    border: none;
}
#QueueText {
    color: #c9d0e0;
    font-size: 12px;
    background: transparent;
    border: none;
}
#QueueOp {
    background: transparent;
    color: #8b93a7;
    border: none;
    border-radius: 4px;
    padding: 0;
    font-size: 12px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}
#QueueOp:hover { background-color: #232838; color: #eef1fa; }
#QueueOp:disabled { color: #4b5265; }

/* ⚡ 引导发送：↑ 左侧次级小按钮，仅忙碌时可见（琥珀色与停止/发送区分） */
#GuideBtn {
    background-color: #232734;
    color: #f0b862;
    border: 1px solid #323849;
    border-radius: 13px;
    padding: 0;
    font-size: 13px;
}
#GuideBtn:hover { background-color: #2d3242; color: #ffd08a; border-color: #3d4456; }

/* 引导消息气泡的发送时间（HH:MM，仅引导消息显示） */
#BubbleTime {
    color: #7d8596;
    font-size: 10px;
    background: transparent;
    border: none;
    padding: 1px 2px 0 2px;
}

/* ---------- 左栏二级栏目（智能助理下面直接显示） ---------- */
#NavSubHost { background: transparent; border: none; }
#NavSub { background: transparent; border: none; }
#NavSubTitle {
    color: #6d7585;
    font-size: 10px;
    font-weight: 700;
    background: transparent;
    border: none;
    padding-left: 6px;
}
#NavSubAdd {
    background: transparent;
    color: #8b93a7;
    border: none;
    border-radius: 6px;
    padding: 0;
    font-size: 13px;
}
#NavSubAdd:hover { background-color: #232838; color: #eef1fa; }
#NavSessList { background: transparent; border: none; outline: 0; }
#NavSessList::item {
    color: #a9b1c2;
    border: none;
    border-radius: 6px;
    padding-left: 8px;
    margin: 0 6px;
    font-size: 12px;
}
#NavSessList::item:hover { background-color: #1d2230; color: #eef1fa; }
#NavSessList::item:selected { background-color: #20263a; color: #ffffff; }

/* 左栏「任务 / 空间」两区（语义对齐 WorkBuddy：任务=一次对话，空间=工作区目录） */
#NavTaskScroll, #NavTaskBody { background: transparent; border: none; }
#NavGroupTitle {
    color: #6d7585;
    font-size: 10px;
    font-weight: 700;
    background: transparent;
    border: none;
    padding: 8px 0 2px 20px;
}
#NavTaskItem {
    background: transparent;
    color: #a9b1c2;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding-left: 18px;
    margin: 0 6px;
    font-size: 12px;
}
#NavTaskItem:hover { background-color: #1d2230; color: #eef1fa; }
#NavTaskItem[active="true"] { background-color: #20263a; color: #ffffff; }
#NavTaskItem[sub="true"] {
    padding-left: 34px;
    font-size: 11px;
    color: #98a1b4;
}
#NavTaskItem[sub="true"][active="true"] { color: #ffffff; }
#NavTaskItem[more="true"] {
    padding-left: 34px;
    font-size: 11px;
    color: #7f8aa3;
}
#NavTaskItem[more="true"]:hover { color: #cfd7e8; }
#NavSpaceItem {
    background: transparent;
    color: #b0b9cc;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding-left: 18px;
    margin: 0 6px;
    font-size: 12px;
}
#NavSpaceItem:hover { background-color: #1d2230; color: #eef1fa; }
#NavSpaceItem[open="true"] { color: #eef1fa; }
#NavEmpty {
    color: #6d7585;
    font-size: 11px;
    background: transparent;
    border: none;
    padding: 5px 20px 7px 20px;
}
#NavSubItem {
    background: transparent;
    color: #a9b1c2;
    border: none;
    border-radius: 6px;
    text-align: left;
    /* 注：1.0.8 起左栏已无「技能/工具/MCP/审计」二级入口（迁到底栏 [+] 菜单），
       此处样式保留以兼容历史主题，新代码不再使用 #NavSubItem 对象名 */
    padding: 0 0 0 26px;
    font-size: 12px;
}
#NavSubItem:hover { background-color: #1d2230; color: #eef1fa; }

/* 输入框下方的小胶囊控件（提供商 / 模型 / 密钥 / 审批 / 工作区 / 停止） */
#Pill {
    background-color: #1c2030;
    color: #b3bccf;
    border: 1px solid #2b3244;
    border-radius: 11px;
    padding: 2px 8px;
    min-height: 22px;
    max-height: 24px;
    font-size: 11px;
}
#Pill:hover { background-color: #242a3b; border-color: #3a4157; color: #e6e9f2; }
#Pill:disabled { background-color: #171b26; color: #5b6275; border-color: #232734; }
#Pill:focus { border-color: #4d5f96; }

QComboBox#Pill::drop-down { width: 14px; border: none; }
QComboBox#Pill QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    color: #b3bccf;
    font-size: 11px;
}
QComboBox#Pill QAbstractItemView { font-size: 12px; padding: 2px; }

/* 旧的 #Pill / #IconBtn 样式保留：其它页面（模型库等）仍在复用胶囊与图标按钮 */
#IconBtn {
    background-color: #1c2030;
    color: #b3bccf;
    border: 1px solid #2b3244;
    border-radius: 13px;
    padding: 0;
    font-size: 15px;
}
#IconBtn:hover { background-color: #242a3b; color: #e6e9f2; border-color: #3a4157; }

#ComposerTip {
    color: #5f6779;
    font-size: 10px;
    background: transparent;
    border: none;
}

#GhostBtn {
    background: transparent;
    color: #9aa3b7;
    border: 1px solid #2f3648;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
}
#GhostBtn:hover { background-color: #232838; color: #e6e9f2; border-color: #3d4456; }

/* 错误条：比普通步骤行更醒目（模型 404 / 审批超时 / 网络失败） */
#ErrorLine {
    color: #ff9db2;
    background-color: #2a1720;
    border: 1px solid #5a2f44;
    border-left: 3px solid #d9536f;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 12px;
}
